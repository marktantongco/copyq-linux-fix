[Context]
filesystems=xdg-config/gtk-3.0:ro;xdg-config/gtk-4.0:ro;xdg-config/kdeglobals:ro
sockets=wayland
dbus=session	alk=org.gnome.Shell;org.gnome.Shell.Screenshot;org.gnome.Shell.Extensions.CopyQClipboardMonitor

[Environment]
# v2.0: Native Wayland mode — NO XWayland forcing.
# CopyQ v14.0.0+ uses the GNOME Shell extension (MetaSelection D-Bus bridge)
# for clipboard monitoring on GNOME Wayland. Forcing QT_QPA_PLATFORM=xcb
# BREAKS clipboard monitoring (Issue #3587, #2811).
# 
# The GNOME Shell extension is installed separately by the installer
# and communicates with CopyQ via the D-Bus interface above.
COPYQ_USE_PORTAL=1
